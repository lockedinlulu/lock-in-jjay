/* ============================================
   TIMER STATE
   ============================================ */
const TIMER_MODES = {
  pomodoro:{label:'Focus Session',  mins:25},
  short:   {label:'Short Break',    mins:5},
  long:    {label:'Long Break',     mins:15},
  custom:  {label:'Custom Session', mins:30}
};
let timerInterval=null, timerRunning=false;
let timerSecsLeft=25*60, timerTotalSecs=25*60, timerMode='pomodoro';
let completedPomodoros=0;

/* ============================================
   UTILITY
   ============================================ */
function toggleDark(){
  document.body.classList.toggle('dark');
  document.getElementById('dark-btn').textContent = document.body.classList.contains('dark')?'☀️':'🌙';
