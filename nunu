  if(app.currentUser){
    sub.textContent=`Showing matches for ${app.currentUser.getFirstName()} — sorted by compatibility`;
    const matches=MatchEngine.rankMatches(app.currentUser,app.students);
    grid.innerHTML=matches.map(m=>{
      const s=m.student;
      return `<div class="student-card" onclick="openProfile(${s.id})">
        <div class="match-score">${m.score}%</div>
        <div class="card-top">${renderAvatar(s)}
          <div><div class="card-name">${s.name}</div><div class="card-meta">${s.major} · ${s.year||''}</div></div>
        </div>
        ${s.bio?`<div class="card-bio">${s.bio}</div>`:''}
        <div class="card-tags">
          ${m.sharedCourses.map(c=>`<span class="tag course">📚 ${c}</span>`).join('')}
          <span class="tag vibe">${s.vibeProfile.getEmoji()} ${s.vibeProfile.getLabel()}</span>
        </div>
        <div class="compat-bar-wrap">
          <div class="compat-bar"><div class="compat-fill" style="width:${m.score}%"></div></div>
          <div class="compat-label"><span>${m.sharedCourses.length} shared course${m.sharedCourses.length!==1?'s':''}</span><span>${m.sharedAvail.length} shared slots</span></div>
        </div>
        <div style="margin-top:8px;display:flex;gap:8px;align-items:center">
          ${s.linkedin?`<a class="tag course" href="${s.linkedin}" target="_blank" onclick="event.stopPropagation()" style="text-decoration:none">🔗 LinkedIn</a>`:''}
          <button onclick="event.stopPropagation();openChat(${s.id})" style="padding:4px 10px;background:var(--navy-dark);color:#fff;border:none;border-radius:999px;font-size:10px;font-weight:700;cursor:pointer">💬 Message</button>
        </div>
      </div>`;
    }).join('');
  } else {
    sub.textContent=`${app.students.length} students looking for study partners`;
    grid.innerHTML=app.students.map(s=>`
      <div class="student-card" onclick="openProfile(${s.id})">
        <div class="card-top">${renderAvatar(s)}
          <div><div class="card-name">${s.name}</div><div class="card-meta">${s.major} · ${s.year||''}</div></div>
        </div>
