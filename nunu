  }
}

function openProfile(id){
  const s=app.students.find(x=>x.id===id);
  if(!s) return;
  let matchHtml='';
  if(app.currentUser && app.currentUser.id!==id){
    const m=MatchEngine.calculateMatch(app.currentUser,s);
    matchHtml=`<div style="background:var(--blue-xlight);border:1px solid var(--blue);border-radius:var(--radius-sm);padding:.9rem;margin-bottom:1rem">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:5px">
        <span style="font-weight:800;color:var(--navy)">Compatibility</span>
