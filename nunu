/* ============================================
   CHAT
   ============================================ */
function renderChatSidebar(){
  const container=document.getElementById('chat-contacts');
  const unreadIds=[];
  container.innerHTML=app.students.map(s=>{
    const thread=app.getThread(s.id);
    const last=thread.length?thread[thread.length-1]:null;
    const preview=last?last.text.slice(0,38)+'…':'Say hello!';
    const unread=thread.filter(m=>m.fromId===s.id).length;
    if(unread>0) unreadIds.push(s.id);
    return `<div class="chat-contact ${app.activeChatId===s.id?'active':''}" onclick="openChat(${s.id})">
      ${renderAvatar(s,36)}
      <div style="flex:1;min-width:0">
        <div class="chat-contact-name">${s.name}</div>
        <div class="chat-contact-preview">${preview}</div>
      </div>
      ${unread?`<div class="unread-badge">${unread}</div>`:''}
    </div>`;
  }).join('');
  document.getElementById('msg-dot').style.display=unreadIds.length?'inline-block':'none';
}

function openChat(sid){
  if(!app.currentUser){
    alert('Create your profile first to start messaging!');
    openSignup(); return;
  }
  showPage('chat');
  app.activeChatId=sid;
  renderChatSidebar();
  const s=app.students.find(x=>x.id===sid);
  const main=document.getElementById('chat-main');
  main.innerHTML=`
    <div class="chat-header">
      ${renderAvatar(s,32)}
      <div>
        <div>${s.name}</div>
        <div style="font-size:11px;color:var(--muted);font-weight:400">${s.major} · ${s.vibeProfile.getEmoji()} ${s.vibeProfile.getLabel()}</div>
      </div>
    </div>
    <div class="chat-messages" id="msg-list"></div>
    <div class="chat-input-row">
      <input type="text" id="chat-input" placeholder="Type a message…" onkeydown="if(event.key==='Enter')sendMsg(${sid})"/>
      <button class="send-btn" onclick="sendMsg(${sid})">Send</button>
    </div>`;
  renderMessages(sid);
  /* give XP for opening first chat */
  if(!app.getThread(sid).find(m=>m.fromId==='user')){
    /* first time messaging this person */
  }
}

function renderMessages(sid){
  const list=document.getElementById('msg-list');
  if(!list) return;
  const thread=app.getThread(sid);
  list.innerHTML=thread.map(m=>{
    const isMe=m.fromId==='user';
    return `<div class="chat-bubble-wrap ${isMe?'me':''}">
      <div class="chat-bubble ${isMe?'me':'them'}">${m.text}</div>
      <div class="chat-bubble-time">${m.formatTime()}</div>
    </div>`;
  }).join('');
  list.scrollTop=list.scrollHeight;
}

const autoReplyPool = {
  1:["Sounds good! See you there 👍","I'll bring my laptop and notes.","LeetCode grind? I'm in!","Yeah CSCI 272 is rough this semester."],
  2:["Omg yes I need help with that too 😭","The library has good study rooms on the 4th floor.","Can we meet Tuesday afternoon?","POL 101 exam is next week ahh"],
  3:["Great! I can walk you through it step by step.","No problem! That concept is tricky at first.","Office hours are also Fridays 2-4pm.","Happy to help!"],
  4:["YES hackathon team let's gooo 🚀","I'm using React + Node for mine.","The CS department has a project showcase next month.","We should submit something!"],
  5:["The problem sets are so hard 😭","I actually found a good YouTube series for MTH 241.","Let's study at the library Tuesday?","I have all the past exams if you want them!"]
};
let replyTimeouts={};
function sendMsg(sid){
  const input=document.getElementById('chat-input');
  const text=input.value.trim();
  if(!text) return;
  app.sendMessage(sid,text);
  input.value='';
  renderMessages(sid);
  /* award XP for messaging */
  app.xpSystem.addXP(5);
  showXPToast(5,'Message sent');
  /* auto-reply after 1.5s */
  clearTimeout(replyTimeouts[sid]);
  replyTimeouts[sid]=setTimeout(()=>{
    const pool=autoReplyPool[sid]||["Got it!","Sure!","Let me know!"];
    const reply=pool[Math.floor(Math.random()*pool.length)];
    app.receiveMessage(sid,reply);
    renderMessages(sid);
    renderChatSidebar();
  },1500);
}

/* ============================================
   TIMER
   ============================================ */
function setMode(mode, el){
  if(timerRunning) return;
  timerMode=mode;
  document.querySelectorAll('.timer-mode-btn').forEach(b=>b.classList.remove('active'));
  el.classList.add('active');
  const mins=TIMER_MODES[mode].mins;
  timerSecsLeft=mins*60; timerTotalSecs=mins*60;
  document.getElementById('timer-label').textContent=TIMER_MODES[mode].label;
  updateTimerDisplay();
  updateTimerFill();
}

function updateTimerDisplay(){
  const m=Math.floor(timerSecsLeft/60);
  const s=timerSecsLeft%60;
  document.getElementById('timer-display').textContent=
    String(m).padStart(2,'0')+':'+String(s).padStart(2,'0');
}

function updateTimerFill(){
  const pct=timerTotalSecs>0?(timerSecsLeft/timerTotalSecs)*100:0;
  document.getElementById('timer-fill').style.width=pct+'%';
}

function renderTimerDots(){
  const dots=document.getElementById('timer-dots');
  if(!dots) return;
  const arr=Array(4).fill(0).map((_,i)=>`<div class="session-dot ${i<completedPomodoros?'done':''}"></div>`);
  dots.innerHTML=arr.join('');
}

function updateSessionLog(){
  const log=document.getElementById('session-log');
  if(!log) return;
  if(!app.sessions.length){log.textContent='No sessions yet — start your first Pomodoro!';return;}
  log.innerHTML=app.sessions.slice(-5).reverse().map(s=>`
    <div style="display:flex;align-items:center;justify-content:space-between;padding:.35rem 0;border-bottom:1px solid var(--border)">
      <span>${s.label()}</span>
      <span style="color:var(--navy);font-weight:700;font-size:12px">+${s.getXP()} XP</span>
    </div>`).join('');
}

function toggleTimer(){
  if(!app.currentUser){ alert('Join StudySync to track your study sessions!'); openSignup(); return; }
  if(timerRunning){
    clearInterval(timerInterval);
    timerRunning=false;
    document.getElementById('timer-toggle').textContent='▶ Resume';
  } else {
    timerRunning=true;
    document.getElementById('timer-toggle').textContent='⏸ Pause';
    timerInterval=setInterval(()=>{
      timerSecsLeft--;
      updateTimerDisplay();
      updateTimerFill();
      if(timerSecsLeft<=0){
        clearInterval(timerInterval);
        timerRunning=false;
        document.getElementById('timer-toggle').textContent='▶ Start';
        const session=new TimerSession(timerMode, TIMER_MODES[timerMode].mins);
        session.markComplete();
        const xp=app.addSession(session);
        if(timerMode==='pomodoro'){ completedPomodoros=(completedPomodoros+1)%4; }
        renderTimerDots();
        updateSessionLog();
        updateTimerXPLabel();
        showXPToast(xp, session.label());
        if(timerMode==='pomodoro') setMode('short',document.querySelector('.timer-mode-btn:nth-child(2)'));
      }
    },1000);
  }
}

function resetTimer(){
  clearInterval(timerInterval);
  timerRunning=false;
  timerSecsLeft=TIMER_MODES[timerMode].mins*60;
  timerTotalSecs=timerSecsLeft;
  document.getElementById('timer-toggle').textContent='▶ Start';
  updateTimerDisplay();
  updateTimerFill();
}

function updateTimerXPLabel(){
  const el=document.getElementById('timer-xp-today');
  if(el) el.innerHTML=`Today: <strong>${app.todayXP} XP</strong> earned`;
}

