<script>
/* =============================================
   OOP CLASSES (core application model)
   ============================================= */

class VibeProfile {
  constructor(type) {
    this.type = type;
    this.vibes = {
      silent:   { label:'Silent grinder',      emoji:'🎧' },
      explainer:{ label:'Explainer',            emoji:'📝' },
      casual:   { label:'Casual collaborator',  emoji:'☕' },
      crunch:   { label:'Crunch mode',          emoji:'⚡' }
    };
    this.compat = {
      silent:   {silent:100,explainer:60,casual:40,crunch:30},
      explainer:{silent:60,explainer:100,casual:85,crunch:55},
      casual:   {silent:40,explainer:85,casual:100,crunch:45},
      crunch:   {silent:30,explainer:55,casual:45,crunch:100}
    };
  }
  getLabel(){ return this.vibes[this.type]?.label || this.type }
  getEmoji(){ return this.vibes[this.type]?.emoji || '' }
  getCompatibility(other){ return this.compat[this.type]?.[other.type] || 50 }
}

class Course {
  constructor(code){ this.code = code.trim().toUpperCase() }
}

class XPSystem {
  constructor(){ this.xp=0; this.level=1; this.sessionXP=0 }
  addXP(amount){
    this.xp += amount;
    this.sessionXP += amount;
    this.level = Math.floor(this.xp / 200) + 1;
  }
  getLevelLabel(){
    const labels = ['',  'Freshman','Sophomore','Study Pro','Dean\'s List','Valedictorian'];
    return labels[Math.min(this.level, labels.length-1)] || 'Legend';
  }
  getProgress(){ return ((this.xp % 200) / 200) * 100 }
  getNextXP(){ return 200 - (this.xp % 200) }
}

class Student {
  constructor(id, name, major, year, bio, courses, vibe, color, pfp, linkedin, avail){
    this.id = id;
    this.name = name;
    this.major = major;
    this.year = year;
    this.bio = bio;
    this.courses = courses.map(c => new Course(c));
    this.vibeProfile = new VibeProfile(vibe);
    this.color = color;
    this.pfp = pfp;
    this.linkedin = linkedin;
    this.avail = avail;
    this.xp = Math.floor(Math.random()*600)+50;
    this.streak = Math.floor(Math.random()*12)+1;
  }
  getCourseCodes(){ return this.courses.map(c=>c.code) }
  getInitials(){
    return this.name.split(' ').map(p=>p[0]).join('').slice(0,2).toUpperCase()
  }
  getFirstName(){ return this.name.split(' ')[0] }
  getSharedCourses(other){
    return this.getCourseCodes().filter(c=>other.getCourseCodes().includes(c))
  }
  getSharedAvailability(other){
    return this.avail.filter(s=>other.avail.includes(s))
  }
}

class MatchResult {
  constructor(student, score, sharedCourses, sharedAvail){
    this.student=student; this.score=score;
    this.sharedCourses=sharedCourses; this.sharedAvail=sharedAvail;
  }
}

class MatchEngine {
  static calculateMatch(a, b){
    const sc = a.getSharedCourses(b);
    const sa = a.getSharedAvailability(b);
    const courseScore = Math.min(100, sc.length*33);
    const vibeScore = a.vibeProfile.getCompatibility(b.vibeProfile);
    const availScore = Math.min(100, sa.length*25);
    const final = Math.round(courseScore*.45 + vibeScore*.35 + availScore*.20);
    return new MatchResult(b, final, sc, sa);
  }
  static rankMatches(user, all){
    return all.filter(s=>s.id!==user.id)
      .map(s=>this.calculateMatch(user,s))
      .sort((a,b)=>b.score-a.score);
  }
}

/* ── Message class ── */
class Message {
  constructor(fromId, toId, text, ts=null){
    this.fromId=fromId; this.toId=toId; this.text=text;
    this.ts = ts || new Date();
  }
  formatTime(){
    return this.ts.toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'});
  }
}

/* ── TimerSession class ── */
class TimerSession {
  constructor(mode, minutes){
    this.mode=mode; this.minutes=minutes;
    this.startedAt=new Date(); this.completed=false;
  }
  markComplete(){ this.completed=true }
  getXP(){ return this.mode==='pomodoro'?50: this.mode==='short'?10:20 }
  label(){
    const h=this.startedAt.toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'});
    return `${h} — ${this.minutes}min ${this.mode}`;
  }
}

/* ── AppState ── */
class AppState {
  constructor(){
    this.students=[];
    this.currentUser=null;
    this.xpSystem=new XPSystem();
    this.messages={}; // key: "fromId-toId"
    this.sessions=[]; // TimerSession[]
    this.streak=0;
    this.nextId=6;
    this.formState={ courses:[], vibe:'', avail:{}, color:'#002d72', pfpData:null };
    this.todayXP=0;
    this.activeChatId=null;
  }
  addStudent(s){ this.students.push(s) }
  setCurrentUser(s){ this.currentUser=s }
  resetForm(){
    this.formState={ courses:[], vibe:'', avail:{}, color:'#002d72', pfpData:null };
  }
  sendMessage(toId, text){
    const key=`user-${toId}`;
    if(!this.messages[key]) this.messages[key]=[];
    this.messages[key].push(new Message('user', toId, text));
  }
  receiveMessage(fromId, text){
    const key=`user-${fromId}`;
    if(!this.messages[key]) this.messages[key]=[];
    this.messages[key].push(new Message(fromId,'user',text));
  }
  getThread(sid){ return this.messages[`user-${sid}`] || [] }
  addSession(session){
    this.sessions.push(session);
    const xp = session.getXP();
    this.xpSystem.addXP(xp);
    this.todayXP += xp;
    return xp;
  }
}

/* ============================================
   SEED DATA
   ============================================ */
const DAYS=['Mon','Tue','Wed','Thu','Fri'];
const TIMES=['Morning','Afternoon','Evening'];
const app = new AppState();

app.students = [
  new Student(1,'Alex Rivera','Computer Science','Junior','Love DSA and competitive programming. Always down to grind LeetCode.',['CSCI 271','CSCI 272','MTH 241'],'silent','#1a4a9e',null,'https://linkedin.com/in/alexrivera',['Mon-Morning','Wed-Morning','Fri-Morning','Fri-Afternoon']),
  new Student(2,'Jordan Kim','Criminal Justice','Sophomore','Pre-law track. Looking for study partners for midterms.',['CSCI 272','ENG 101','POL 101'],'casual','#d4537e',null,'',['Mon-Afternoon','Tue-Afternoon','Thu-Morning']),
  new Student(3,'Sam Okonkwo','Computer Science','Senior','TA for CSCI 271. Happy to explain concepts — that\'s how I learn.',['CSCI 271','MTH 241','CRJ 101'],'explainer','#7F77DD',null,'https://linkedin.com/in/samokonkwo',['Wed-Morning','Wed-Afternoon','Fri-Morning']),
  new Student(4,'Maya Torres','Computer Science','Junior','Full-stack dev. Hackathon enthusiast. Need a study group ASAP.',['CSCI 272','ENG 101'],'crunch','#D85A30',null,'',['Thu-Evening','Fri-Evening','Mon-Evening']),
  new Student(5,'Chris Lam','Mathematics','Freshman','Tutoring available for MTH 241. Just starting CSCI.',['MTH 241','CSCI 271','ENG 101'],'explainer','#4a90d9',null,'https://linkedin.com/in/chrislam',['Mon-Morning','Tue-Morning','Wed-Morning','Thu-Morning'])
];

/* seed some messages */
const autoReplies = {
  1:["Hey! I'm free Wed morning if you want to study CSCI 272?","What IDE do you use?","Let's do a LeetCode session this week!"],
  2:["Sure! I'm working on POL 101 right now 😅","Do you have notes from last Tuesday?","Group study at the library?"],
