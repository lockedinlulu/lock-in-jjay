<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>StudySync JJ</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display&display=swap" rel="stylesheet"/>
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --navy:#002d72;--navy-dark:#001a45;--navy-mid:#1a4a9e;
  --blue:#4a90d9;--blue-light:#c8dcf5;--blue-xlight:#e8f2fc;
  --white:#fff;--offwhite:#f5f8fe;--text:#0d1b2e;--muted:#4a6080;
  --border:#ccdcef;--card:#fff;--bg:#eef4fc;
  --green:#1a7a4a;--green-bg:#e6f5ed;
  --amber:#b86a00;--amber-bg:#fff3dc;
  --red:#c0392b;--red-bg:#fdecea;
  --radius:14px;--radius-sm:9px;
  --shadow:0 4px 20px rgba(0,45,114,0.10);
}
body.dark{
  --navy:#4a7fd4;--navy-dark:#1a3a6e;--navy-mid:#6a9fe8;
  --blue:#78aff5;--blue-light:#1e3a5f;--blue-xlight:#0e2040;
  --white:#111c2e;--offwhite:#0c1626;--text:#e8f0fb;--muted:#8aabcc;
  --border:#1e3a5f;--card:#132238;--bg:#08111f;
  --green-bg:#0e2a18;--amber-bg:#221800;--red-bg:#2a0e0e;
}
body{font-family:'DM Sans',sans-serif;background:var(--bg);color:var(--text);min-height:100vh;font-size:14px}
a{color:var(--navy);text-decoration:none}
button{cursor:pointer;font-family:'DM Sans',sans-serif}
nav{background:var(--navy-dark);padding:0 1.5rem;display:flex;align-items:center;justify-content:space-between;height:56px;position:sticky;top:0;z-index:100;box-shadow:0 2px 12px rgba(0,0,0,0.18)}
.nav-logo{font-family:'DM Serif Display',serif;font-size:20px;color:#fff}
.nav-logo span{color:#78b3f5}
.nav-links{display:flex;gap:6px;align-items:center}
.nav-btn{padding:7px 14px;border-radius:var(--radius-sm);font-size:13px;font-weight:600;border:none;transition:all .15s}
.nav-btn.ghost{background:rgba(255,255,255,0.10);color:#fff}
.nav-btn.ghost:hover{background:rgba(255,255,255,0.18)}
.nav-btn.primary{background:#4a90d9;color:#fff}
.nav-btn.primary:hover{background:#357abd}
.nav-btn.active{background:rgba(255,255,255,0.22);color:#fff}
.notif-dot{display:inline-block;width:7px;height:7px;background:#e74c3c;border-radius:50%;margin-left:4px;vertical-align:middle}

.page{display:none;min-height:calc(100vh - 56px)}
.page.active{display:block}

/* ── HERO ── */
.hero{max-width:680px;margin:0 auto;padding:4.5rem 1.5rem 2.5rem;text-align:center}
.hero h1{font-family:'DM Serif Display',serif;font-size:46px;line-height:1.1;margin-bottom:.8rem;color:var(--text)}
.hero h1 em{font-style:normal;color:var(--navy)}
.hero p{font-size:17px;color:var(--muted);max-width:440px;margin:0 auto 1.8rem;line-height:1.6}
.hero-btn{display:inline-block;padding:12px 32px;background:var(--navy-dark);color:#fff;border:none;border-radius:var(--radius);font-size:15px;font-weight:700;box-shadow:var(--shadow);transition:all .15s}
body.dark .hero-btn{background:var(--navy)}
.hero-btn:hover{transform:translateY(-1px);background:var(--navy-mid)}
.hero-pills{display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin-top:2rem}
.pill{padding:6px 14px;background:var(--card);border:1px solid var(--border);border-radius:999px;font-size:12px;color:var(--muted)}

/* ── BROWSE ── */
.section{max-width:960px;margin:0 auto;padding:1.5rem}
.section-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:1.2rem;flex-wrap:wrap;gap:10px}
.section-title{font-size:19px;font-weight:700}
.students-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:14px}
.student-card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:1.1rem;cursor:pointer;transition:all .15s;position:relative;box-shadow:0 2px 10px rgba(0,45,114,0.05)}
.student-card:hover{border-color:var(--blue);box-shadow:var(--shadow);transform:translateY(-2px)}
.card-top{display:flex;align-items:flex-start;gap:10px;margin-bottom:.8rem}
.avatar{width:44px;height:44px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:14px;flex-shrink:0;overflow:hidden}
.avatar img{width:100%;height:100%;object-fit:cover;border-radius:50%}
.card-name{font-weight:700;font-size:14px;margin-bottom:1px}
.card-meta{font-size:11px;color:var(--muted)}
.card-bio{font-size:12px;color:var(--muted);margin-bottom:.6rem;line-height:1.5;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.card-tags{display:flex;flex-wrap:wrap;gap:4px;margin-bottom:.6rem}
.tag{padding:3px 8px;border-radius:999px;font-size:10px;font-weight:700}
.tag.course{background:var(--blue-xlight);color:var(--navy)}
.tag.vibe{background:var(--blue-light);color:var(--navy)}
body.dark .tag.course{color:#78aff5}
body.dark .tag.vibe{color:#78aff5}
.match-score{position:absolute;top:10px;right:10px;background:var(--navy-dark);color:#fff;font-size:11px;font-weight:800;padding:3px 8px;border-radius:999px}
body.dark .match-score{background:var(--navy)}
.compat-bar-wrap{margin:4px 0 2px}
.compat-bar{height:5px;background:var(--blue-xlight);border-radius:999px;overflow:hidden}
.compat-fill{height:100%;background:var(--navy);border-radius:999px}
body.dark .compat-fill{background:var(--blue)}
.compat-label{font-size:10px;color:var(--muted);display:flex;justify-content:space-between;margin-top:2px}
.filter-row{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:1rem}
.filter-chip{padding:5px 11px;border:1px solid var(--border);border-radius:999px;font-size:11px;cursor:pointer;background:var(--card);color:var(--text)}
.filter-chip.active{background:var(--navy-dark);color:#fff;border-color:var(--navy-dark)}
body.dark .filter-chip.active{background:var(--navy)}

/* ── MODAL ── */
.modal-overlay{display:none;position:fixed;inset:0;background:rgba(5,15,35,.5);z-index:200;align-items:center;justify-content:center;padding:1rem}
.modal-overlay.open{display:flex}
.modal{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);max-width:540px;width:100%;max-height:90vh;overflow-y:auto;padding:1.8rem;position:relative;box-shadow:var(--shadow)}
.modal-close{position:absolute;top:.9rem;right:.9rem;background:none;border:none;font-size:22px;cursor:pointer;color:var(--muted);line-height:1}
.modal-close:hover{color:var(--text)}
.modal h2{font-size:19px;font-weight:800;margin-bottom:1.2rem}
.form-group{margin-bottom:.9rem}
label{display:block;font-size:12px;font-weight:700;margin-bottom:4px;color:var(--text)}
input[type=text],input[type=url],select,textarea{width:100%;padding:9px 11px;border:1px solid var(--border);border-radius:var(--radius-sm);font-family:'DM Sans',sans-serif;font-size:13px;color:var(--text);background:var(--white);transition:border .15s}
input:focus,select:focus,textarea:focus{outline:none;border-color:var(--navy)}
textarea{resize:none;height:66px}
.pfp-row{display:flex;align-items:center;gap:12px;margin-bottom:.9rem}
.pfp-preview{width:56px;height:56px;border-radius:50%;object-fit:cover;border:2px solid var(--border)}
.pfp-btn{padding:7px 13px;border:1px solid var(--border);border-radius:var(--radius-sm);background:var(--offwhite);color:var(--text);font-size:12px;font-weight:700}
.pfp-btn:hover{background:var(--blue-xlight)}
.color-row{display:flex;gap:6px;margin-top:5px}
.color-swatch{width:24px;height:24px;border-radius:50%;cursor:pointer;transition:transform .1s;border:2px solid transparent}
.color-swatch.selected,.color-swatch:hover{transform:scale(1.25);outline:2px solid var(--navy)}
.course-input-row{display:flex;gap:7px}
.course-input-row input{flex:1}
.add-btn{padding:9px 12px;background:var(--navy-dark);color:#fff;border:none;border-radius:var(--radius-sm);font-size:13px;font-weight:700;white-space:nowrap}
body.dark .add-btn{background:var(--navy)}
.add-btn:hover{background:var(--navy-mid)}
.tags-container{display:flex;flex-wrap:wrap;gap:5px;margin-top:7px;min-height:26px}
.removable-tag{display:inline-flex;align-items:center;gap:3px;padding:4px 9px;background:var(--blue-xlight);color:var(--navy);border-radius:999px;font-size:11px;font-weight:700}
.removable-tag button{background:none;border:none;color:var(--navy);cursor:pointer;font-size:13px;line-height:1;padding:0}
.quick-add-row{display:flex;flex-wrap:wrap;gap:5px;margin-top:5px}
.quick-chip{font-size:11px;color:var(--navy);cursor:pointer;padding:3px 8px;border:1px solid var(--blue);border-radius:999px;background:var(--blue-xlight);font-weight:700}
.quick-chip:hover{background:var(--blue-light)}
.vibe-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px}
.vibe-opt{border:1px solid var(--border);border-radius:var(--radius-sm);padding:.65rem;cursor:pointer;transition:all .12s;background:var(--white)}
.vibe-opt:hover{border-color:var(--blue);background:var(--blue-xlight)}
.vibe-opt.selected{border:2px solid var(--navy);background:var(--blue-xlight)}
.vibe-opt .vt{font-size:12px;font-weight:800;margin-bottom:1px}
.vibe-opt .vd{font-size:10px;color:var(--muted)}
.avail-grid{display:grid;grid-template-columns:auto repeat(5,1fr);gap:3px}
.avail-cell{text-align:center;font-size:10px;padding:5px 2px;border-radius:6px;cursor:pointer;border:1px solid var(--border);color:var(--muted);background:var(--white);transition:all .1s;user-select:none}
.avail-cell:hover{border-color:var(--blue)}
.avail-cell.on{background:var(--navy-dark);border-color:var(--navy-dark);color:#fff}
body.dark .avail-cell.on{background:var(--navy)}
.avail-cell.header{background:var(--blue-xlight);cursor:default;font-weight:800;border-color:transparent;color:var(--navy)}
.save-btn{width:100%;padding:11px;background:var(--navy-dark);color:#fff;border:none;border-radius:var(--radius-sm);font-size:14px;font-weight:800;margin-top:.4rem;transition:all .15s}
body.dark .save-btn{background:var(--navy)}
.save-btn:hover{background:var(--navy-mid);transform:translateY(-1px)}
#form-error{font-size:12px;color:var(--red);margin-bottom:7px;display:none}

/* ── CHAT ── */
.chat-layout{display:grid;grid-template-columns:240px 1fr;height:calc(100vh - 56px);max-width:100%;overflow:hidden}
.chat-sidebar{background:var(--card);border-right:1px solid var(--border);overflow-y:auto;display:flex;flex-direction:column}
.chat-sidebar-header{padding:.9rem 1rem;border-bottom:1px solid var(--border);font-weight:700;font-size:14px;display:flex;align-items:center;justify-content:space-between}
.chat-contact{display:flex;align-items:center;gap:10px;padding:.7rem 1rem;cursor:pointer;border-bottom:1px solid var(--border);transition:background .1s}
.chat-contact:hover,.chat-contact.active{background:var(--blue-xlight)}
.chat-contact-name{font-weight:600;font-size:13px}
.chat-contact-preview{font-size:11px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:130px}
.unread-badge{background:var(--navy-dark);color:#fff;font-size:10px;font-weight:800;padding:2px 6px;border-radius:999px;margin-left:auto;flex-shrink:0}
body.dark .unread-badge{background:var(--navy)}
.chat-main{display:flex;flex-direction:column;height:100%;overflow:hidden}
.chat-header{padding:.8rem 1.2rem;border-bottom:1px solid var(--border);font-weight:700;font-size:14px;display:flex;align-items:center;gap:10px;flex-shrink:0;background:var(--card)}
.chat-messages{flex:1;overflow-y:auto;padding:1rem 1.2rem;display:flex;flex-direction:column;gap:.6rem}
.chat-bubble-wrap{display:flex;flex-direction:column}
.chat-bubble-wrap.me{align-items:flex-end}
.chat-bubble{max-width:68%;padding:.55rem .9rem;border-radius:14px;font-size:13px;line-height:1.5}
.chat-bubble.them{background:var(--offwhite);border:1px solid var(--border);border-radius:14px 14px 14px 4px;color:var(--text)}
.chat-bubble.me{background:var(--navy-dark);color:#fff;border-radius:14px 14px 4px 14px}
body.dark .chat-bubble.me{background:var(--navy)}
.chat-bubble-time{font-size:10px;color:var(--muted);margin-top:2px}
.chat-input-row{display:flex;gap:8px;padding:.8rem 1.2rem;border-top:1px solid var(--border);flex-shrink:0;background:var(--card)}
.chat-input-row input{flex:1;padding:9px 12px;border:1px solid var(--border);border-radius:var(--radius-sm);font-family:'DM Sans',sans-serif;font-size:13px;color:var(--text);background:var(--white)}
.chat-input-row input:focus{outline:none;border-color:var(--navy)}
.send-btn{padding:9px 16px;background:var(--navy-dark);color:#fff;border:none;border-radius:var(--radius-sm);font-weight:700;font-size:13px}
body.dark .send-btn{background:var(--navy)}
.send-btn:hover{background:var(--navy-mid)}
.no-chat-selected{display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;color:var(--muted);font-size:14px;gap:.5rem}
.chat-empty-icon{font-size:40px;margin-bottom:.5rem}

/* ── TIMER ── */
.timer-page{max-width:640px;margin:0 auto;padding:2rem 1.5rem}
.timer-card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:2rem;text-align:center;box-shadow:var(--shadow);margin-bottom:1.2rem}
.timer-display{font-size:72px;font-weight:800;font-variant-numeric:tabular-nums;color:var(--navy-dark);letter-spacing:2px;margin:.5rem 0}
body.dark .timer-display{color:var(--blue)}
.timer-label{font-size:13px;color:var(--muted);font-weight:600;text-transform:uppercase;letter-spacing:.08em;margin-bottom:1.2rem}
.timer-btn-row{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}
.timer-btn{padding:10px 22px;border-radius:var(--radius-sm);font-size:14px;font-weight:700;border:none;transition:all .15s}
.timer-btn.start{background:var(--navy-dark);color:#fff}
body.dark .timer-btn.start{background:var(--navy)}
.timer-btn.start:hover{background:var(--navy-mid)}
.timer-btn.reset{background:var(--offwhite);color:var(--text);border:1px solid var(--border)}
.timer-btn.reset:hover{background:var(--blue-xlight)}
.timer-mode-row{display:flex;gap:8px;justify-content:center;margin-bottom:1.2rem;flex-wrap:wrap}
.timer-mode-btn{padding:6px 15px;border:1px solid var(--border);border-radius:999px;font-size:12px;font-weight:700;background:var(--card);color:var(--muted);transition:all .15s}
.timer-mode-btn.active{background:var(--navy-dark);color:#fff;border-color:var(--navy-dark)}
body.dark .timer-mode-btn.active{background:var(--navy);border-color:var(--navy)}
.timer-progress-bar{height:6px;background:var(--blue-xlight);border-radius:999px;overflow:hidden;margin:.8rem 0}
.timer-progress-fill{height:100%;background:var(--navy);border-radius:999px;transition:width .5s linear}
body.dark .timer-progress-fill{background:var(--blue)}
.timer-sessions-row{display:flex;gap:6px;justify-content:center;margin-top:.6rem}
.session-dot{width:10px;height:10px;border-radius:50%;background:var(--border)}
.session-dot.done{background:var(--navy)}
body.dark .session-dot.done{background:var(--blue)}
.xp-toast{position:fixed;bottom:24px;right:24px;background:var(--navy-dark);color:#fff;padding:.7rem 1.2rem;border-radius:var(--radius-sm);font-size:13px;font-weight:700;box-shadow:var(--shadow);z-index:300;animation:slideUp .3s ease}
@keyframes slideUp{from{transform:translateY(20px);opacity:0}to{transform:translateY(0);opacity:1}}

/* ── LEADERBOARD ── */
.leaderboard-page{max-width:640px;margin:0 auto;padding:1.5rem}
.lb-card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow)}
.lb-header{background:var(--navy-dark);color:#fff;padding:1rem 1.2rem;display:flex;align-items:center;justify-content:space-between}
body.dark .lb-header{background:var(--navy-dark)}
.lb-header-title{font-size:16px;font-weight:800}
.lb-header-sub{font-size:11px;opacity:.7}
.lb-row{display:flex;align-items:center;gap:12px;padding:.75rem 1.2rem;border-bottom:1px solid var(--border);transition:background .1s}
.lb-row:last-child{border-bottom:none}
.lb-row:hover{background:var(--blue-xlight)}
.lb-rank{font-size:16px;font-weight:800;width:28px;text-align:center;flex-shrink:0}
.lb-rank.gold{color:#c8a800}
.lb-rank.silver{color:#8a9bb0}
.lb-rank.bronze{color:#a0613a}
.lb-name{flex:1;font-weight:600;font-size:13px}
.lb-meta{font-size:11px;color:var(--muted)}
.lb-xp{font-weight:800;font-size:14px;color:var(--navy)}
body.dark .lb-xp{color:var(--blue)}
.lb-streak{font-size:11px;color:var(--amber);font-weight:700}
.lb-you{background:var(--blue-xlight);border-left:3px solid var(--navy)}
body.dark .lb-you{border-left-color:var(--blue)}

/* ── MY PROFILE ── */
.profile-page{max-width:680px;margin:0 auto;padding:1.5rem}
.profile-hero{background:var(--navy-dark);border-radius:var(--radius);padding:1.8rem;color:#fff;display:flex;align-items:center;gap:1.2rem;margin-bottom:1.2rem;position:relative;overflow:hidden}
body.dark .profile-hero{background:linear-gradient(135deg,#0e2040,#1a3a6e)}
.profile-hero-avatar{width:80px;height:80px;border-radius:50%;border:3px solid rgba(255,255,255,.35);display:flex;align-items:center;justify-content:center;font-size:26px;font-weight:800;flex-shrink:0;overflow:hidden}
.profile-hero-avatar img{width:100%;height:100%;object-fit:cover;border-radius:50%}
.profile-hero-name{font-size:22px;font-weight:800;margin-bottom:2px}
.profile-hero-meta{font-size:13px;opacity:.75;margin-bottom:.6rem}
.xp-bar-wrap{background:rgba(255,255,255,.2);border-radius:999px;height:6px;overflow:hidden;width:200px}
.xp-bar-fill{height:100%;background:#78b3f5;border-radius:999px}
.xp-label{font-size:11px;opacity:.7;margin-top:3px}
.level-badge{position:absolute;top:1rem;right:1rem;background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.25);border-radius:999px;padding:.3rem .8rem;font-size:12px;font-weight:800;color:#fff}
.stat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:1.2rem}
.stat-card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius-sm);padding:.9rem;text-align:center;box-shadow:0 2px 8px rgba(0,45,114,0.05)}
.stat-val{font-size:22px;font-weight:800;color:var(--navy)}
body.dark .stat-val{color:var(--blue)}
.stat-lbl{font-size:10px;color:var(--muted);font-weight:600;text-transform:uppercase;letter-spacing:.06em;margin-top:2px}
.streak-row{display:flex;gap:6px;margin:1rem 0}
.streak-day{width:34px;height:34px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;background:var(--blue-xlight);color:var(--muted)}
.streak-day.done{background:var(--navy-dark);color:#fff}
body.dark .streak-day.done{background:var(--navy)}
.streak-day.today{outline:2px solid var(--blue);outline-offset:2px}
.profile-section{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:1.1rem;margin-bottom:1rem}
.profile-section-title{font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.07em;color:var(--muted);margin-bottom:.8rem}
.edit-btn-sm{padding:5px 11px;border:1px solid var(--border);border-radius:var(--radius-sm);background:var(--offwhite);color:var(--text);font-size:11px;font-weight:700}
.edit-btn-sm:hover{background:var(--blue-xlight)}
.badge-grid{display:flex;gap:8px;flex-wrap:wrap}
.badge{padding:.4rem .8rem;border-radius:999px;font-size:11px;font-weight:700;border:1px solid}
.badge.earned{background:var(--blue-xlight);color:var(--navy);border-color:var(--blue)}
.badge.locked{background:var(--offwhite);color:var(--muted);border-color:var(--border)}
body.dark .badge.earned{color:#78aff5}

/* ── dark mode inputs ── */
body.dark input[type=text],body.dark input[type=url],body.dark select,body.dark textarea,body.dark .chat-input-row input{background:#0e1f36;color:var(--text);border-color:var(--border)}
body.dark .vibe-opt{background:#0e1f36;border-color:var(--border)}
body.dark .avail-cell{background:#0e1f36;border-color:var(--border);color:var(--muted)}
body.dark .avail-cell.header{background:#0e2040;color:#78aff5}
@media(max-width:640px){
  .chat-layout{grid-template-columns:1fr}
  .chat-sidebar{display:none}
  .stat-grid{grid-template-columns:repeat(2,1fr)}
  .hero h1{font-size:36px}
}
</style>
</head>
<body>

<nav>
  <div class="nav-logo">Study<span>Sync</span> JJ</div>
  <div class="nav-links">
    <button class="nav-btn ghost" id="nb-home" onclick="showPage('home')">Home</button>
    <button class="nav-btn ghost" id="nb-browse" onclick="showPage('browse')">Browse</button>
