/* ============================================
   SIGNUP FORM
   ============================================ */
function openSignup(){
  app.resetForm();
  ['f-name','f-major','f-bio','f-linkedin','f-course-input'].forEach(id=>{document.getElementById(id).value=''});
  document.getElementById('f-year').value='';
  document.getElementById('course-tags').innerHTML='';
  document.querySelectorAll('.vibe-opt').forEach(v=>v.classList.remove('selected'));
  document.querySelectorAll('.color-swatch').forEach(s=>{
    s.classList.remove('selected');
    if(s.dataset.color==='#002d72') s.classList.add('selected');
  });
  document.getElementById('pfp-preview').style.display='none';
  document.getElementById('pfp-initials').style.display='flex';
  document.getElementById('pfp-initials').textContent='?';
  document.getElementById('pfp-initials').style.background='#002d72';
  document.getElementById('form-error').style.display='none';
  buildAvailGrid();
  document.getElementById('modal-signup').classList.add('open');
}

function closeModal(id){ document.getElementById(id).classList.remove('open') }

function updateInitials(){
  const name=document.getElementById('f-name').value.trim();
  const initials=name?name.split(' ').map(p=>p[0]).join('').slice(0,2).toUpperCase():'?';
  document.getElementById('pfp-initials').textContent=initials;
}

function handlePfp(input){
  const file=input.files[0]; if(!file) return;
  const reader=new FileReader();
  reader.onload=e=>{
    app.formState.pfpData=e.target.result;
    document.getElementById('pfp-preview').src=e.target.result;
    document.getElementById('pfp-preview').style.display='block';
    document.getElementById('pfp-initials').style.display='none';
  };
  reader.readAsDataURL(file);
}

function pickColor(el){
  document.querySelectorAll('.color-swatch').forEach(s=>s.classList.remove('selected'));
  el.classList.add('selected');
  app.formState.color=el.dataset.color;
  document.getElementById('pfp-initials').style.background=app.formState.color;
}

function addCourse(){
  const input=document.getElementById('f-course-input');
  const val=input.value.trim().toUpperCase();
  if(!val||app.formState.courses.includes(val)) return;
  app.formState.courses.push(val);
  renderCourseTags(); input.value='';
}

function quickCourse(c){
  if(!app.formState.courses.includes(c)){ app.formState.courses.push(c); renderCourseTags(); }
}

function removeCourse(c){
  app.formState.courses=app.formState.courses.filter(x=>x!==c); renderCourseTags();
}

function renderCourseTags(){
  document.getElementById('course-tags').innerHTML=app.formState.courses.map(c=>
    `<span class="removable-tag">${c}<button onclick="removeCourse('${c}')" aria-label="Remove ${c}">×</button></span>`
  ).join('');
}

function pickVibe(el,vibe){
  document.querySelectorAll('.vibe-opt').forEach(v=>v.classList.remove('selected'));
  el.classList.add('selected'); app.formState.vibe=vibe;
}

function buildAvailGrid(){
  const grid=document.getElementById('avail-grid'); grid.innerHTML='';
  const blank=document.createElement('div');
  blank.style.cssText='background:transparent;border:none';
  grid.appendChild(blank);
  DAYS.forEach(d=>{ const c=document.createElement('div'); c.className='avail-cell header'; c.textContent=d; grid.appendChild(c); });
  TIMES.forEach(t=>{
    const tc=document.createElement('div'); tc.className='avail-cell header'; tc.textContent=t.slice(0,3); grid.appendChild(tc);
    DAYS.forEach(d=>{
      const key=d+'-'+t; const cell=document.createElement('div');
      cell.className='avail-cell'+(app.formState.avail[key]?' on':'');
      cell.onclick=()=>{ app.formState.avail[key]=!app.formState.avail[key]; cell.classList.toggle('on'); };
      grid.appendChild(cell);
    });
  });
}

function submitProfile(){
  const name=document.getElementById('f-name').value.trim();
  const major=document.getElementById('f-major').value.trim();
  const err=document.getElementById('form-error');
  if(!name||!major){ err.textContent='Please fill in your name and major.'; err.style.display='block'; return; }
  if(!app.formState.courses.length){ err.textContent='Add at least one course.'; err.style.display='block'; return; }
  if(!app.formState.vibe){ err.textContent='Pick your study vibe.'; err.style.display='block'; return; }
  err.style.display='none';
  const s=new Student(
    app.nextId++, name, major,
    document.getElementById('f-year').value,
    document.getElementById('f-bio').value.trim(),
    [...app.formState.courses], app.formState.vibe, app.formState.color,
    app.formState.pfpData, document.getElementById('f-linkedin').value.trim(),
    Object.keys(app.formState.avail).filter(k=>app.formState.avail[k])
  );
  app.addStudent(s); app.setCurrentUser(s);
  app.xpSystem.addXP(100); app.todayXP+=100;
  app.streak=1;
  closeModal('modal-signup');
  showXPToast(100,'Profile created!');
  setTimeout(()=>showPage('browse'),300);
}

